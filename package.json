{
  "name": "dashforge-rn-workspace",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @dashforge/rn build",
    "typecheck": "pnpm --filter @dashforge/rn typecheck",
    "test": "pnpm --filter @dashforge/rn test",
    "test:all": "pnpm -r test",
    "start": "pnpm --filter dashforge-rn-example start",
    "ios": "pnpm --filter dashforge-rn-example ios",
    "android": "pnpm --filter dashforge-rn-example android",
    "clean": "pnpm -r clean"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-test-renderer": "19.2.3",
      "typescript": "~5.9.2"
    }
  }
}
